# Copy to .env and adjust. Every value is optional in development.
PORT=4000
NODE_ENV=development

# REQUIRED in production. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
TOKEN_TTL_HOURS=12

DB_PATH=./data/attendance.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIMEZONE=Asia/Kolkata

# Create demo teacher/students/courses when the database is empty (development only)
SEED_ON_EMPTY=true

# Development may allow ID-only student login; production requires password login.
REQUIRE_PASSWORD=false

# Which proofs a student needs before attendance is recorded: ble, qr, face
REQUIRED_FACTORS=ble,face

# BLE: minimum RSSI (dBm) to count as "in the classroom". -60 is very close, -90 is far.
BLE_MIN_RSSI=-80

# Dynamic QR: lifetime of each token, plus network/scan grace
QR_TTL_SECONDS=5
QR_GRACE_SECONDS=3

# Face liveness
LIVENESS_MIN_SCORE=0.85
LIVENESS_CHALLENGE_TTL_SECONDS=30
LIVENESS_SERVICE_TIMEOUT_MS=15000
# Start the service in ../face-liveness before marking attendance.
LIVENESS_SERVICE_URL=http://127.0.0.1:8001/verify
LIVENESS_SERVICE_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# How long a student has to finish all steps after tapping "Mark Attendance"
ATTEMPT_TTL_MINUTES=10
